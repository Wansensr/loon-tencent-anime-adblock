#!name = 腾讯动漫去广告 v1.1.5
#!desc = 腾讯动漫去广告 v1.1.5：自动更新测试，拦截广告域名、开屏配置接口和开屏广告素材
#!icon = https://raw.githubusercontent.com/Wansensr/loon-tencent-anime-adblock/main/tencent-anime-icon.jpg
#!author = Codex
#!homepage = https://github.com/Wansensr/loon-tencent-anime-adblock
#!type = normal

[Rule]
# 腾讯广告 SDK / 优量汇
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,ad.qq.com,REJECT
DOMAIN-SUFFIX,ads.qq.com,REJECT
DOMAIN-SUFFIX,adx.qq.com,REJECT
DOMAIN-SUFFIX,adcdn.qq.com,REJECT
DOMAIN-SUFFIX,pgdt.gtimg.com,REJECT
DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT

# 广告监测 / 推广统计
DOMAIN-SUFFIX,l.qq.com,REJECT
DOMAIN-SUFFIX,beacon.qq.com,REJECT
DOMAIN-SUFFIX,pingjs.qq.com,REJECT
DOMAIN-SUFFIX,pingfore.qq.com,REJECT
DOMAIN-SUFFIX,tajs.qq.com,REJECT
DOMAIN-SUFFIX,oth.eve.mdt.qq.com,REJECT
DOMAIN-SUFFIX,oth.str.mdt.qq.com,REJECT
DOMAIN-SUFFIX,report.qq.com,REJECT
DOMAIN-SUFFIX,trace.qq.com,REJECT
DOMAIN-SUFFIX,h.trace.qq.com,REJECT
[Rewrite]
# 腾讯动漫开屏配置接口：直接拒绝，避免返回开屏广告配置
^https?:\\/\\/iphone\\.ac\\.qq\\.com\\/.*\\/Support\\/(getSystemConf|bootScreen) - reject
# 腾讯动漫开屏广告主素材：直接让请求失败，避免透明图继续触发开屏容器
# 公开规则参考：Zz1xuan/ONE TencentComic.plugin
^https:\/\/manhua\.acimg\.cn\/operation\/0\/[^/?]+\.jpg\/0\?tp=sharp(?:&.*)?$ - reject

[MitM]
hostname = manhua.acimg.cn,iphone.ac.qq.com
